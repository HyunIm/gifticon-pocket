{
  "name": "gifticon-pocket",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "build": { "command": "node scripts/refresh-offline-cache.mjs" },
  // Static files are served directly; the Worker only runs for /api/* and the share target.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // One object per push subscription holds that device's reminders and wakes up by alarm.
  "durable_objects": {
    "bindings": [{ "name": "PUSH", "class_name": "PushReminders" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushReminders"] }]
}
